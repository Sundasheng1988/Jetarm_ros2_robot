<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>place_manager</name>
  <version>0.1.0</version>

  <description>
    Place Manager — named place management for mobile robot navigation.
    Provides ROS2 services to save/delete/list/get named locations,
    reads the current robot pose from /amcl_pose, and persists to YAML.
  </description>

  <maintainer email="sundasheng@todo.todo">sundasheng</maintainer>
  <license>MIT</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Custom service generation -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- ROS dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>

  <!--
    navigation.launch.py 启动 executor_done_sayer（属于 llm_voice_agent），
    并解析 launch 文件，因此显式声明这些运行期依赖。std_msgs/std_srvs 已在上文
    作为 <depend> 声明（既是构建期也是运行期依赖）。
  -->
  <exec_depend>llm_voice_agent</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Python runtime dependency -->
  <exec_depend>python3-yaml</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Tests -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
