<?xml version="1.0"?>
<package format="3">
  <name>social_robot</name>
  <version>0.0.1</version>
  <description>Social robot face follow module</description>

  <maintainer email="robot@example.com">robot</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS2 Python 节点所需 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <!-- 原厂 servo_controller 的消息类型 -->
  <exec_depend>servo_controller_msgs</exec_depend>

  <!-- Mediapipe & OpenCV（Python 依赖） -->
  <exec_depend>mediapipe</exec_depend>
  <exec_depend>opencv-python</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

