<?xml version="1.0"?>
<package format="3">
  <name>llm_voice_agent</name>
  <version>0.0.3</version>
  <description>Voice dialog agent that bridges speech -> LLM -> text topics</description>
  <maintainer email="you@example.com">sundasheng</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>
  <exec_depend>servo_controller_msgs</exec_depend>
  <exec_depend>python3-requests</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
